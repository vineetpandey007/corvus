# Copy this file to .env and fill in real values.
# .env is gitignored — never commit real API keys, secrets, or credentials.

# ============================================================
# Database (SQLite by default — no setup needed. Use Postgres in production.)
# ============================================================
# DATABASE_URL=postgresql+psycopg2://user:password@localhost:5432/sih_dwta

# ============================================================
# Auth — REQUIRED before running the API
# ============================================================
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
JWT_SECRET_KEY=
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Optional: static key for service-to-service calls (X-API-Key header).
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
API_SERVICE_KEY=

# ============================================================
# Encryption at rest — REQUIRED before ingesting real case data
# ============================================================
# Generate with: python -c "from src.utils.encryption import generate_key; print(generate_key())"
ENCRYPTION_KEY=

# ============================================================
# Email (password reset links, OTP codes)
# ============================================================
# "dev" (default): nothing is actually sent — emails are logged to the
#   console and appended to <app-data-dir>/dev_email_outbox.jsonl, so you
#   can grab reset links / OTP codes during local development/testing.
# "smtp": sends real email — also set the SMTP_* values below.
EMAIL_BACKEND=dev
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USERNAME=
# SMTP_PASSWORD=
# SMTP_FROM=

# ============================================================
# OAuth login (Google / GitHub) — optional. Unset = that login button's
# backend route returns a clear "not configured" error; nothing else in
# the app is affected.
# ============================================================
# Google: console.cloud.google.com -> APIs & Services -> Credentials ->
#   OAuth client ID (type: Web application) -> Authorized redirect URI:
#   http://localhost:8000/auth/oauth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# GitHub: github.com/settings/developers -> OAuth Apps -> New OAuth App ->
#   Authorization callback URL: http://localhost:8000/auth/oauth/github/callback
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
# Must match whatever origin the backend is actually reachable at — used
# to build the OAuth redirect_uri sent to Google/GitHub.
BACKEND_BASE_URL=http://localhost:8000

# ============================================================
# Blockchain tracing
# ============================================================
# Public Etherscan API key (free tier): https://etherscan.io/apis
BLOCKEXPLORER_API_KEY=
# Bitcoin tracing uses Blockstream's public API — no key required.

# ============================================================
# Graph backend (only needed if config.yaml -> graph.backend: "neo4j")
# ============================================================
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=

# ============================================================
# Tor SOCKS proxy (only for real, legally authorized live collection)
# ============================================================
TOR_SOCKS_PROXY=socks5h://127.0.0.1:9050

# ============================================================
# Logging
# ============================================================
LOG_LEVEL=INFO
